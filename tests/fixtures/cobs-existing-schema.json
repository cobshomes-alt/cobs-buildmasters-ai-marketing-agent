  "functions": [
    {
      "config": ["search_path=public"],
      "definition": "CREATE OR REPLACE FUNCTION public.cobs_is_owner()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$ select exists (select 1 from public.cobs_profiles where id = auth.uid() and role = 'owner') $function$\n",
      "name": "cobs_is_owner",
      "security_definer": true
    },
    {
      "config": ["search_path=public"],
      "definition": "CREATE OR REPLACE FUNCTION public.cobs_new_user_profile()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nbegin\r\n  insert into public.cobs_profiles (id, email, role)\r\n  values (new.id, coalesce(new.email, ''), case when lower(coalesce(new.email, '')) = 'cobshomes@gmail.com' then 'owner' else 'member' end)\r\n  on conflict (id) do nothing;\r\n  return new;\r\nend;\r\n$function$\n",
      "name": "cobs_new_user_profile",
      "security_definer": true
    },
    {
      "config": ["search_path=public"],
      "definition": "CREATE OR REPLACE FUNCTION public.cobs_touch_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$ begin new.updated_at = now(); return new; end; $function$\n",
      "name": "cobs_touch_updated_at",
      "security_definer": false
    }
  ],
