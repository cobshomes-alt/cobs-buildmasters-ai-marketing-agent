NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional; server only. Generation uses your existing API account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local Windows rendering only; never enable this as a cloud worker substitute.
COBS_LOCAL_RENDER_ENABLED=0
# Optional lower limits (maximum 20 jobs/day and 1 GiB reserved input/30 days).
COBS_RENDER_DAILY_LIMIT=20
COBS_RENDER_MONTHLY_BYTES=1073741824
